# 같이가숲 개발 환경 설정 예시 (비밀값 없음)
#
# 이 파일을 Mac의 ~/.config/familyjourney/env 로 복사한 뒤 값을 바꿉니다.
#   mkdir -p ~/.config/familyjourney
#   cp tools/env.example ~/.config/familyjourney/env
#
# - 형식: 한 줄에 KEY=VALUE. '#'으로 시작하는 줄은 주석입니다.
# - 따옴표는 없어도 됩니다. 값 맨 앞의 ~ 와 $HOME 은 홈 폴더로 바뀝니다.
# - 같은 이름의 환경 변수가 있으면 환경 변수가 이깁니다.
# - 실제 값 파일(~/.config/familyjourney/env)은 저장소에 올리지 않습니다.
#   블라인드 원칙: 계정 이름이 들어간 주소를 저장소 파일에 적지 않기 위해서입니다.
# - 토큰·비밀번호는 여기에도 적지 않습니다. GitHub 로그인은 gh가 키체인에 보관합니다.

# [필수] 저장소 주소. "owner/name" 또는 https 주소
GGF_REPO=OWNER/REPO

# [선택] 클론할 폴더 (기본: ~/Projects/familyjourney)
#GGF_DIR=~/Projects/familyjourney

# [선택] 볼 브랜치 (기본: 원격 저장소의 기본 브랜치)
# AI가 지금 작업 중인 브랜치(claude/...)는 메인 에이전트가 알려 줍니다.
#GGF_BRANCH=claude/work-branch-name

# [권장] 이 저장소 안에서만 쓰는 커밋 작성자. 전역 git 설정은 바꾸지 않습니다.
GGF_GIT_NAME=DriveXFamily
# 중립 GitHub 계정의 noreply 주소를 권장합니다.
# GitHub → Settings → Emails → "Keep my email addresses private" 아래에 보이는 주소
#GGF_GIT_EMAIL=12345678+neutral-account@users.noreply.github.com

# [선택] Android SDK·Pleos 이미지 라이선스 자동 동의
# 터미널이 아닌 곳(Remote Control 등)에서 setup.sh를 돌릴 때만 필요합니다.
# 라이선스 내용을 직접 읽고 동의한 사람만 yes로 바꿉니다.
#   Android SDK License Agreement: https://developer.android.com/studio/terms
#   Pleos Connect SDK License(42dot): Android Studio SDK Manager에서 이미지 설치 시 표시
#GGF_ACCEPT_ANDROID_LICENSES=no

# [선택] 에뮬레이터 AVD 이름 (기본: PleosConnect)
#GGF_AVD=PleosConnect

# [선택] 부팅을 기다리는 최대 시간(초, 기본 600)
#GGF_BOOT_TIMEOUT=600
